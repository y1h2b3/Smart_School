<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.www.mapper.LogisticsMapper">

    <resultMap id="BaseResultMap" type="Logistics">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="type" column="type" jdbcType="VARCHAR"/>
        <result property="deviceId" column="device_id" jdbcType="VARCHAR"/>
        <result property="logisticsId" column="logistics_id" jdbcType="INTEGER"/>
        <result property="post" column="post" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="password" column="password" jdbcType="VARCHAR"/>
        <result property="phone" column="phone" jdbcType="VARCHAR"/>
        <result property="sex" column="sex" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,type,device_id,
        logistics_id,post,name,
        username,password,phone,
        sex,create_time,update_time
    </sql>
    <update id="updateLogistics">
        update logistics
        <set>
            <if test="image != null">
                img=#{image},
            </if>
            <if test="type != null">
                type=#{type},
            </if>
            <if test="deviceId != null">
                device_id=#{deviceId},
            </if>
            <if test="logisticsId != null">
                logistics_id=#{logisticsId},
            </if>
            <if test="post != null">
                post=#{post},
            </if>
            <if test="name != null">
                name=#{name},
            </if>
            <if test="phone != null">
                phone=#{phone},
            </if>
            <if test="birth != null">
                birth=#{birth},
            </if>
            <if test="status!=null">
                status= #{status},
            </if>
        </set>
        where logistics_id=#{logisticsId}
    </update>
    <delete id="removeLogisticsByLid">
        delete
        from logistics
        where logistics_id = #{logisticsId}
    </delete>
    <select id="findAlllogistics" resultType="com.smart.www.pojo.Logistics">
        select
        device_id,img as image,logistics_id,post,name,birth,phone,sex,status,create_time,update_time,password
        from logistics
        <if test="orders != null">
            ORDER BY ${orders}
            <if test="isAsc">
                ASC
            </if>
            <if test="!isAsc">
                DESC
            </if>
        </if>
        limit #{size} offset #{offset}
    </select>
    <select id="searchByName" resultType="com.smart.www.pojo.Logistics">
        select
        device_id,img as image,logistics_id,post,name,birth,phone,sex,status,create_time,update_time,password
        from logistics
        where name like concat('%',#{value},'%')
        <if test="orders != null">
            ORDER BY ${orders}
            <if test="isAsc">
                ASC
            </if>
            <if test="!isAsc">
                DESC
            </if>
        </if>
        limit #{size} offset #{offset}
    </select>
    <select id="searchByType" resultType="com.smart.www.pojo.Logistics">
        select
        device_id,img as image,logistics_id,post,name,birth,phone,sex,status,create_time,update_time,password
        from logistics
        where post like concat('%',#{value},'%')
        <if test="orders != null">
            ORDER BY ${orders}
            <if test="isAsc">
                ASC
            </if>
            <if test="!isAsc">
                DESC
            </if>
        </if>
        limit #{size} offset #{offset}
    </select>
    <select id="searchBylogisticsId" resultType="com.smart.www.pojo.Logistics">
        select
        device_id,img as image,logistics_id,post,name,birth,phone,sex,status,create_time,update_time,password
        from logistics
        where logistics_id like concat('%',#{value},'%')
        <if test="orders != null">
            ORDER BY ${orders}
            <if test="isAsc">
                ASC
            </if>
            <if test="!isAsc">
                DESC
            </if>
        </if>
        limit #{size} offset #{offset}
    </select>
    <select id="searchBysex" resultType="com.smart.www.pojo.Logistics">
        select
        device_id,img as image,logistics_id,post,name,birth,phone,sex,status,create_time,update_time,password
        from logistics
        where sex like concat('%',#{value},'%')
        <if test="orders != null">
            ORDER BY ${orders}
            <if test="isAsc">
                ASC
            </if>
            <if test="!isAsc">
                DESC
            </if>
        </if>
        limit #{size} offset #{offset}
    </select>
    <select id="searchByStatus" resultType="com.smart.www.pojo.Logistics">
        select
        device_id,img as image,logistics_id,post,name,birth,phone,sex,status,create_time,update_time,password
        from logistics
        where status like concat('%',#{value},'%')
        <if test="orders != null">
            ORDER BY ${orders}
            <if test="isAsc">
                ASC
            </if>
            <if test="!isAsc">
                DESC
            </if>
        </if>
        limit #{size} offset #{offset}
    </select>
    <select id="countLogistics" resultType="java.lang.Integer">
        SELECT count(*) FROM logistics
        <where>
            <if test="name != null">
                and name like concat('%',#{name},'%')
            </if>
            <if test="post != null">
                and post like concat('%',#{post},'%')
            </if>
            <if test="id != null">
                and logistics_id like concat('%',#{id},'%')
            </if>
            <if test="phone != null">
                AND s.phone = #{phone}
            </if>
        </where>
    </select>
    <select id="searchLogistics" resultType="com.smart.www.pojo.Logistics">
        select
        device_id,img as image,logistics_id,post,name,birth,phone,sex,status,create_time,update_time,password
        from logistics
        <where>
            <if test="name != null">
                and name like concat('%',#{name},'%')
            </if>
            <if test="post != null">
                and post like concat('%',#{post},'%')
            </if>
            <if test="id != null">
                and logistics_id like concat('%',#{id},'%')
            </if>
            <if test="phone != null">
                AND s.phone = #{phone}
            </if>
        </where>
        <if test="orders != null">
            ORDER BY ${orders}
            <if test="isAsc">
                ASC
            </if>
            <if test="!isAsc">
                DESC
            </if>
        </if>
        limit #{size} offset #{offset}
    </select>
    <select id="findAlllogistics2" resultType="com.smart.www.pojo.Logistics">
        select device_id,
               img as image,
               logistics_id,
               post,
               name,
               birth,
               phone,
               sex,
               status,
               create_time,
               update_time,
               password
        from logistics
    </select>
</mapper>
