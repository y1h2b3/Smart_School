        limit #{size} offset #{offset}
    </select>
    <select id="countTeacher" resultType="java.lang.Integer">
        SELECT count(*) FROM teacher
        <where>
            <if test="name != null">
                and name like concat('%',#{name},'%')
            </if>
            <if test="post != null">
                and post like concat('%',#{post},'%')
            </if>
            <if test="id != null">
                and teacher_id like concat('%',#{id},'%')
            </if>
            <if test="phone != null">
                AND s.phone = #{phone}
            </if>
        </where>
    </select>
    <select id="searchTeacher" resultType="com.smart.www.pojo.Teacher">
        select device_id,img as image
        ,teacher_id,post,name,clazz,birth,phone,sex,status,create_time,update_time,password from
        teacher
        <where>
            <if test="name != null">
                and name like concat('%',#{name},'%')
            </if>
            <if test="post != null">
                and post like concat('%',#{post},'%')
            </if>
            <if test="id != null">
                and teacher_id like concat('%',#{id},'%')
            </if>
            <if test="phone != null">
                AND s.phone = #{phone}
            </if>
        </where>
        <if test="orders != null">
            ORDER BY ${orders}
            <if test="isAsc">
                ASC
            </if>
            <if test="!isAsc">
                DESC
            </if>
        </if>
        limit #{size} offset #{offset}
    </select>
    <select id="findAllTeacher2" resultType="com.smart.www.pojo.Teacher">
        select device_id,
               img as image,
               teacher_id,
               post,
               name,
               clazz,
               birth,
               phone,
               sex,
               status,
               create_time,
               update_time,
               password
        from teacher;
    </select>
</mapper>
